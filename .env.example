# =====================================================================
# MUSCLE MONSTER GYM — ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure your credentials
# =====================================================================

# Flask Server Config
FLASK_ENV=development
FLASK_PORT=5000
FLASK_HOST=127.0.0.1
SECRET_KEY=muscle_monster_super_secret_jwt_key_2026_production_grade_token

# MySQL Database Credentials
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=muscle_monster_db

# Local SQLite Fallback (Auto-enables if MySQL service is offline during local test)
USE_SQLITE_FALLBACK=True
